@page "/accounts"
@inject UiLookups Lookups
@inject ILedgerAccountAppService AccountService

<h1>Chart of Accounts</h1>
<h2>Legacy: GKol / GMoin / GTafzili</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">Add account</h2>
    <RadzenTemplateForm TItem="CreateLedgerAccountDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Account">
                <label>Code *</label>
                <RadzenTextBox @bind-Value="@_model.Code" TValue="string" Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Hierarchy">
                <label>Level</label>
                <RadzenDropDown
                    @bind-Value="@_model.Level"
                    TValue="int"
                    Data="@(new[] { 1, 2, 3 })"
                    Style="width:100%" />
                <label>Parent</label>
                <RadzenDropDown
                    @bind-Value="@_model.ParentId"
                    TValue="Guid?"
                    Data="@Lookups.Accounts.Where(a => a.Level < 3)"
                    TextProperty="Code"
                    ValueProperty="Id"
                    Placeholder="—"
                    AllowClear="true"
                    Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    <RadzenDataGrid Data="@_accounts" TValue="LedgerAccountDto" Style="width:100%">
        <Columns>
            <RadzenDataGridColumn TItem="LedgerAccountDto" Property="Code" Title="Code" />
            <RadzenDataGridColumn TItem="LedgerAccountDto" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="LedgerAccountDto" Title="Level">
                <Template>
                    L@context.Level
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LedgerAccountDto" Title="Parent">
                <Template>
                    @(context.ParentId is null ? "—" : Lookups.AccountName(context.ParentId.Value))
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LedgerAccountDto" Title="Posting">
                <Template>
                    @(context.AllowPosting ? "Yes" : "No")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<LedgerAccountDto> _accounts = [];
    private CreateLedgerAccountDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _accounts = [.. await AccountService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await AccountService.CreateAsync(_model);
            _model = new CreateLedgerAccountDto();
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}