@page "/vouchers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IVoucherAppService VoucherService

<h1>Vouchers</h1>
<h2>Journal entries (legacy: Voucher / Voucherms)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New voucher</h2>
    <RadzenTemplateForm TItem="CreateVoucherDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Voucher">
                <label>Number *</label>
                <RadzenTextBox @bind-Value="@_model.Number" TValue="string" Style="width:100%" />
                <label>Date (Jalali, e.g. @JalaliUi.TodayJalali)</label>
                <RadzenTextBox @bind-Value="@_dateJalali" TValue="string" Style="width:100%" />
                <label>Description</label>
                <RadzenTextBox @bind-Value="@_model.Description" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create draft" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_vouchers.Count == 0)
    {
        <p class="muted">No vouchers yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_vouchers" TValue="VoucherDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="VoucherDto" Property="Number" Title="No." />
                <RadzenDataGridColumn TItem="VoucherDto" Title="Date">
                    <Template>
                        @JalaliUi.Format(context.Date)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VoucherDto" Title="Lines">
                    <Template>
                        @context.LineCount
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VoucherDto" Property="TotalDebit" Title="Debit" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="VoucherDto" Property="TotalCredit" Title="Credit" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="VoucherDto" Title="Status">
                    <Template>
                        <RadzenBadge BadgeStyle="@(context.Status == "Draft" ? BadgeStyle.Warning : (context.Status == "Posted" ? BadgeStyle.Success : BadgeStyle.Danger))"
                                     Text="@context.Status" />
                        @if (context.Status == "Draft" && context.TotalDebit != context.TotalCredit)
                        {
                            <span class="muted">(unbalanced)</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VoucherDto" Title="">
                    <Template>
                        @if (context.Status == "Draft")
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Post" Click="@(() => PostAsync(context.Id))" />
                        }
                        else if (context.Status == "Posted")
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Cancel" Click="@(() => CancelAsync(context.Id))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <p class="muted" style="margin-top:0.8rem">
            Vouchers are created draft via the API (<code>POST /api/vouchers</code> + lines); balance and post them here.
        </p>
    }
</RadzenCard>

@code {
    private List<VoucherDto> _vouchers = [];
    private CreateVoucherDto _model = new();
    private string _dateJalali = JalaliUi.TodayJalali;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _vouchers = [.. await VoucherService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            if (!JalaliUi.TryParse(_dateJalali, out var date))
                throw new ArgumentException($"Invalid Jalali date '{_dateJalali}'. Use e.g. 1405/06/21.");

            _model.Date = date;

            await VoucherService.CreateAsync(_model);
            _model = new CreateVoucherDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PostAsync(Guid id)
    {
        _error = null;
        try
        {
            await VoucherService.PostAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelAsync(Guid id)
    {
        _error = null;
        try
        {
            await VoucherService.CancelAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}