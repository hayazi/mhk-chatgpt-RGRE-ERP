@page "/issues"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IIssueAppService IssueService
@inject NavigationManager Navigation

<h1>Issues</h1>
<h2>Warehouse-out documents (legacy: Khorooj / HavaleMasraf)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New issue</h2>
    <RadzenTemplateForm TItem="CreateIssueDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Document">
                <label>Document no. *</label>
                <RadzenTextBox @bind-Value="@_model.DocumentNumber" TValue="string" Style="width:100%" />
                <label>Date (Jalali, e.g. @JalaliUi.TodayJalali)</label>
                <RadzenTextBox @bind-Value="@_dateJalali" TValue="string" Style="width:100%" />
            </RadzenFieldset>

            <RadzenFieldset Legend="Parties">
                <label>Warehouse *</label>
                <RadzenDropDown
                    @bind-Value="@_model.WarehouseId"
                    TValue="Guid"
                    Data="@Lookups.Warehouses"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    Style="width:100%" />

                <label>Receiver</label>
                <RadzenDropDown
                    @bind-Value="@_model.ReceiverPartnerId"
                    TValue="Guid?"
                    Data="@Lookups.Partners"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    AllowClear="true"
                    Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create draft" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_issues.Count == 0)
    {
        <p class="muted">No issues yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_issues" TValue="IssueDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="IssueDto" Title="No.">
                    <Template>
                        <a href="issues/@context.Id">@context.DocumentNumber</a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Date">
                    <Template>
                        @JalaliUi.Format(context.DocumentDate)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Warehouse">
                    <Template>
                        @Lookups.WarehouseName(context.WarehouseId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Receiver">
                    <Template>
                        @Lookups.PartnerName(context.ReceiverPartnerId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Lines">
                    <Template>
                        @context.Lines.Count
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Amount">
                    <Template>
                        @context.Lines.Sum(l => l.Amount).ToString("N2")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="Status">
                    <Template>
                        <RadzenBadge BadgeStyle="@(context.Status == "Draft" ? BadgeStyle.Warning : (context.Status == "Posted" ? BadgeStyle.Success : BadgeStyle.Danger))"
                                     Text="@context.Status" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="IssueDto" Title="">
                    <Template>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Open →" Click="@(() => Navigation.NavigateTo($"issues/{context.Id}"))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<IssueDto> _issues = [];
    private CreateIssueDto _model = new();
    private string _dateJalali = JalaliUi.TodayJalali;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _issues = [.. await IssueService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            if (!JalaliUi.TryParse(_dateJalali, out var date))
                throw new ArgumentException($"Invalid Jalali date '{_dateJalali}'. Use e.g. 1405/06/21.");

            _model.DocumentDate = date;

            var id = await IssueService.CreateAsync(_model);

            Navigation.NavigateTo($"issues/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}