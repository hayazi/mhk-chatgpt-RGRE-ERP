@page "/"
@inject UiLookups Lookups
@inject IStockQueryService StockQuery
@inject IVoucherAppService VoucherService
@inject IReceiptAppService ReceiptService
@inject IIssueAppService IssueService
@inject IStockTransferAppService TransferService

<h1>Dashboard</h1>
<h2>System overview</h2>

@if (!Lookups.Loaded)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenStack Gap="1rem" Orientation="Orientation.Vertical">
        <RadzenCard>
            <RadzenStack Gap="0.6rem">
                <RadzenHeading HeadingStyle="HeadingStyle.H3" Text="Key figures" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                    <RadzenCard Variant="Variant.Outlined" Style="flex:1; min-width:160px">
                        <RadzenText Text="Goods" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@Lookups.Goods.Count.ToString()" TextStyle="TextStyle.H3" />
                    </RadzenCard>
                    <RadzenCard Variant="Variant.Outlined" Style="flex:1; min-width:160px">
                        <RadzenText Text="Warehouses" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@Lookups.Warehouses.Count.ToString()" TextStyle="TextStyle.H3" />
                    </RadzenCard>
                    <RadzenCard Variant="Variant.Outlined" Style="flex:1; min-width:160px">
                        <RadzenText Text="Partners" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@Lookups.Partners.Count.ToString()" TextStyle="TextStyle.H3" />
                    </RadzenCard>
                    <RadzenCard Variant="Variant.Outlined" Style="flex:1; min-width:160px">
                        <RadzenText Text="Ledger accounts" TextStyle="TextStyle.Caption" />
                        <RadzenText Text="@Lookups.Accounts.Count.ToString()" TextStyle="TextStyle.H3" />
                    </RadzenCard>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.6rem">
                <RadzenHeading HeadingStyle="HeadingStyle.H3" Text="Stock value by warehouse" />
                @if (_stockByWarehouse.Count == 0)
                {
                    <p class="muted">No stock movements yet.</p>
                }
                else
                {
                    <RadzenDataGrid Data="@_stockByWarehouse" TValue="(Guid WarehouseId, int Items, decimal Qty, decimal Value)" Style="width:100%">
                        <Columns>
                            <RadzenDataGridColumn TItem="(Guid WarehouseId, int Items, decimal Qty, decimal Value)" Title="Warehouse">
                                <Template>
                                    @Lookups.WarehouseName(context.WarehouseId)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="(Guid WarehouseId, int Items, decimal Qty, decimal Value)" Property="Items" Title="Items" />
                            <RadzenDataGridColumn TItem="(Guid WarehouseId, int Items, decimal Qty, decimal Value)" Property="Qty" Title="Quantity" FormatString="{0:N2}" />
                            <RadzenDataGridColumn TItem="(Guid WarehouseId, int Items, decimal Qty, decimal Value)" Property="Value" Title="Value" FormatString="{0:N2}">
                                <FooterTemplate>
                                    <strong>@_stockByWarehouse.Sum(x => x.Value).ToString("N2")</strong>
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.6rem">
                <RadzenHeading HeadingStyle="HeadingStyle.H3" Text="Recent documents" />
                <RadzenDataGrid Data="@_recentDocs" TValue="(string Type, string Number, string Warehouse, string Status)" Style="width:100%">
                    <Columns>
                        <RadzenDataGridColumn TItem="(string Type, string Number, string Warehouse, string Status)" Property="Type" Title="Type" />
                        <RadzenDataGridColumn TItem="(string Type, string Number, string Warehouse, string Status)" Property="Number" Title="Number" />
                        <RadzenDataGridColumn TItem="(string Type, string Number, string Warehouse, string Status)" Property="Warehouse" Title="Warehouse" />
                        <RadzenDataGridColumn TItem="(string Type, string Number, string Warehouse, string Status)" Title="Status">
                            <Template>
                                <RadzenBadge BadgeStyle="@(context.Status == "Draft" ? BadgeStyle.Warning : (context.Status == "Posted" ? BadgeStyle.Success : BadgeStyle.Danger))"
                                             Text="@context.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}

@code {
    private List<(Guid WarehouseId, int Items, decimal Qty, decimal Value)> _stockByWarehouse = [];
    private List<(string Type, string Number, string Warehouse, string Status)> _recentDocs = [];

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();

        var receipts = await ReceiptService.ListAsync();
        var issues = await IssueService.ListAsync();
        var transfers = await TransferService.ListAsync();
        var vouchers = await VoucherService.ListAsync();

        _recentDocs =
        [
            .. receipts.Select(r => ("Receipt", r.DocumentNumber, Lookups.WarehouseName(r.WarehouseId), r.Status)),
            .. issues.Select(i => ("Issue", i.DocumentNumber, Lookups.WarehouseName(i.WarehouseId), i.Status)),
            .. transfers.Select(t => ("Transfer", t.DocumentNumber,
                $"{Lookups.WarehouseName(t.FromWarehouseId)} → {Lookups.WarehouseName(t.ToWarehouseId)}", t.Status)),
            .. vouchers.Select(v => ("Voucher", v.Number, "—", v.Status)),
        ];

        var balancesByWarehouse = new Dictionary<Guid, List<StockBalanceDto>>();
        foreach (var warehouse in Lookups.Warehouses)
        {
            var balances = await StockQuery.GetByWarehouseAsync(warehouse.Id);
            if (balances.Count > 0)
            {
                balancesByWarehouse[warehouse.Id] = [.. balances];
            }
        }

        _stockByWarehouse = balancesByWarehouse
            .Select(kv => (
                kv.Key,
                kv.Value.Count,
                kv.Value.Sum(b => b.Quantity),
                kv.Value.Sum(b => b.TotalValue)))
            .ToList();
    }
}