@page "/warehouses"
@inject UiLookups Lookups
@inject IWarehouseAppService WarehouseService

<h1>Warehouses</h1>
<h2>Legacy: Anbar</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">Add warehouse</h2>
    <RadzenTemplateForm TItem="CreateWarehouseDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Identification">
                <label>Code *</label>
                <RadzenTextBox @bind-Value="@_model.Code" TValue="string" Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Contact">
                <label>Telephone</label>
                <RadzenTextBox @bind-Value="@_model.Telephone" TValue="string" Style="width:100%" />
                <label>Address</label>
                <RadzenTextBox @bind-Value="@_model.Address" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    <RadzenDataGrid Data="@_warehouses" TValue="Warehouse" Style="width:100%">
        <Columns>
            <RadzenDataGridColumn TItem="Warehouse" Property="Code" Title="Code" />
            <RadzenDataGridColumn TItem="Warehouse" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="Warehouse" Property="Telephone" Title="Telephone" />
            <RadzenDataGridColumn TItem="Warehouse" Property="Address" Title="Address" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<Warehouse> _warehouses = [];
    private CreateWarehouseDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _warehouses = [.. await WarehouseService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await WarehouseService.CreateAsync(_model);
            _model = new CreateWarehouseDto();
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}