@page "/users"
@using RGRE.ERP.Application.Platform
@rendermode InteractiveServer
@inject IUserAdminService UserService
@inject IRoleAdminService RoleService

<h1>Users</h1>
<h2>Application users (legacy: Users + Permissions)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New user</h2>
    <RadzenTemplateForm TItem="CreateUserDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Account">
                <label>Username *</label>
                <RadzenTextBox @bind-Value="@_model.Username" TValue="string" Style="width:100%" />
                <label>Display name *</label>
                <RadzenTextBox @bind-Value="@_model.DisplayName" TValue="string" Style="width:100%" />
                <label>Password *</label>
                <RadzenPassword @bind-Value="@_model.Password" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Roles">
                <RadzenDropDown
                    @bind-Value="@_model.RoleIds"
                    TValue="List<Guid>"
                    Data="@_roles"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Multiple="true"
                    Chips="true"
                    Placeholder="Select roles"
                    Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create user" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_users.Count == 0)
    {
        <p class="muted">No users yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_users" TValue="UserDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="UserDto" Property="Username" Title="Username" />
                <RadzenDataGridColumn TItem="UserDto" Property="DisplayName" Title="Display name" />
                <RadzenDataGridColumn TItem="UserDto" Title="Roles">
                    <Template>
                        @string.Join(", ", _roles.Where(r => context.RoleIds.Contains(r.Id)).Select(r => r.Name))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UserDto" Title="Status">
                    <Template>
                        @if (!context.Enabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disabled" />
                        }
                        else if (context.IsLockedOut)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Locked" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UserDto" Title="">
                    <Template>
                        @if (context.Enabled)
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Disable" Click="@(() => SetEnabledAsync(context, false))" />
                        }
                        else
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Enable" Click="@(() => SetEnabledAsync(context, true))" />
                        }
                        @if (context.IsLockedOut)
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Unlock" Click="@(() => UnlockAsync(context))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<UserDto> _users = [];
    private List<RoleDto> _roles = [];
    private CreateUserDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _users = [.. await UserService.ListAsync()];
        _roles = [.. await RoleService.ListAsync()];
    }

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await UserService.CreateAsync(_model);
            _model = new CreateUserDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetEnabledAsync(UserDto user, bool enabled)
    {
        _error = null;
        try
        {
            await UserService.SetEnabledAsync(user.Id, enabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task UnlockAsync(UserDto user)
    {
        _error = null;
        try
        {
            await UserService.UnlockAsync(user.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}