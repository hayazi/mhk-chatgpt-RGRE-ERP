@page "/transfers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IStockTransferAppService TransferService

<h1>Transfers</h1>
<h2>Inter-warehouse transfers (legacy: EnteghalBeinAnbar)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New transfer</h2>
    <RadzenTemplateForm TItem="CreateStockTransferDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Document">
                <label>Document no. *</label>
                <RadzenTextBox @bind-Value="@_model.DocumentNumber" TValue="string" Style="width:100%" />
                <label>Date (Jalali, e.g. @JalaliUi.TodayJalali)</label>
                <RadzenTextBox @bind-Value="@_dateJalali" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Warehouses">
                <label>From warehouse *</label>
                <RadzenDropDown
                    @bind-Value="@_model.FromWarehouseId"
                    TValue="Guid"
                    Data="@Lookups.Warehouses"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    Style="width:100%" />
                <label>To warehouse *</label>
                <RadzenDropDown
                    @bind-Value="@_model.ToWarehouseId"
                    TValue="Guid"
                    Data="@Lookups.Warehouses"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create draft" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_transfers.Count == 0)
    {
        <p class="muted">No transfers yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_transfers" TValue="StockTransferDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="StockTransferDto" Property="DocumentNumber" Title="No." />
                <RadzenDataGridColumn TItem="StockTransferDto" Title="Date">
                    <Template>
                        @JalaliUi.Format(context.DocumentDate)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockTransferDto" Title="From → To">
                    <Template>
                        @Lookups.WarehouseName(context.FromWarehouseId) → @Lookups.WarehouseName(context.ToWarehouseId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockTransferDto" Title="Lines">
                    <Template>
                        @context.Lines.Count
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockTransferDto" Title="Total qty">
                    <Template>
                        @context.Lines.Sum(l => l.Quantity)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockTransferDto" Title="Status">
                    <Template>
                        <RadzenBadge BadgeStyle="@(context.Status == "Draft" ? BadgeStyle.Warning : (context.Status == "Posted" ? BadgeStyle.Success : BadgeStyle.Danger))"
                                     Text="@context.Status" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockTransferDto" Title="">
                    <Template>
                        @if (context.Status == "Draft")
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Post" Click="@(() => PostAsync(context.Id))" />
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="@(() => CancelDraftAsync(context.Id))" />
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<StockTransferDto> _transfers = [];
    private CreateStockTransferDto _model = new();
    private string _dateJalali = JalaliUi.TodayJalali;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _transfers = [.. await TransferService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            if (!JalaliUi.TryParse(_dateJalali, out var date))
                throw new ArgumentException($"Invalid Jalali date '{_dateJalali}'. Use e.g. 1405/06/21.");

            _model.DocumentDate = date;

            await TransferService.CreateAsync(_model);
            _model = new CreateStockTransferDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PostAsync(Guid id)
    {
        _error = null;
        try
        {
            await TransferService.PostAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelDraftAsync(Guid id)
    {
        _error = null;
        try
        {
            await TransferService.CancelAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}