@page "/transfers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IStockTransferAppService TransferService

<h1>Transfers</h1>
<h2>Inter-warehouse transfers (legacy: EnteghalBeinAnbar)</h2>

<div class="card">
    <h2>New transfer</h2>
    <form @onsubmit="CreateAsync">
        <div class="row">
            <div class="field">
                <label>Document no. *</label>
                <input @bind="_number" />
            </div>
            <div class="field">
                <label>Date (Jalali, e.g. @JalaliUi.TodayJalali)</label>
                <input @bind="_dateJalali" />
            </div>
            <div class="field">
                <label>From warehouse *</label>
                <select @bind="_fromId">
                    <option value="">—</option>
                    @foreach (var w in Lookups.Warehouses)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>To warehouse *</label>
                <select @bind="_toId">
                    <option value="">—</option>
                    @foreach (var w in Lookups.Warehouses)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
        </div>
        <button type="submit">Create draft</button>
        <span class="error">@_error</span>
    </form>
</div>

<div class="card">
    @if (_transfers.Count == 0)
    {
        <p class="muted">No transfers yet.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Date</th>
                    <th>From → To</th>
                    <th class="num">Lines</th>
                    <th class="num">Total qty</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _transfers)
                {
                    var id = t.Id;
                    var isDraft = t.Status == "Draft";
                    <tr>
                        <td>@t.DocumentNumber</td>
                        <td>@JalaliUi.Format(t.DocumentDate)</td>
                        <td>@Lookups.WarehouseName(t.FromWarehouseId) → @Lookups.WarehouseName(t.ToWarehouseId)</td>
                        <td class="num">@t.Lines.Count</td>
                        <td class="num">@t.Lines.Sum(l => l.Quantity)</td>
                        <td><span class="badge @t.Status.ToLower()">@t.Status</span></td>
                        <td>
                            @if (isDraft)
                            {
                                <button @onclick="() => PostAsync(id)">Post</button>
                                <button class="danger" @onclick="() => CancelDraftAsync(id)">Delete</button>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<StockTransferDto> _transfers = [];
    private string _number = "";
    private string _dateJalali = JalaliUi.TodayJalali;
    private string _fromId = "";
    private string _toId = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _transfers = [.. await TransferService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            if (!JalaliUi.TryParse(_dateJalali, out var date))
                throw new ArgumentException($"Invalid Jalali date '{_dateJalali}'. Use e.g. 1405/06/21.");

            await TransferService.CreateAsync(new CreateStockTransferDto
            {
                DocumentNumber = _number,
                DocumentDate = date,
                FromWarehouseId = Guid.Parse(_fromId),
                ToWarehouseId = Guid.Parse(_toId),
            });
            _number = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PostAsync(Guid id)
    {
        _error = null;
        try
        {
            await TransferService.PostAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelDraftAsync(Guid id)
    {
        _error = null;
        try
        {
            await TransferService.CancelAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
