@page "/branches"
@using RGRE.ERP.Application.Platform
@rendermode InteractiveServer
@inject IOrganizationService OrganizationService

<h1>Branches</h1>
<h2>Company branches (legacy: Branchs)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New branch</h2>
    <RadzenTemplateForm TItem="CreateBranchDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Branch">
                <label>Company *</label>
                <RadzenDropDown
                    @bind-Value="@_model.CompanyId"
                    TValue="Guid"
                    Data="@_companies"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    Style="width:100%" />
                <label>Code *</label>
                <RadzenTextBox @bind-Value="@_model.Code" TValue="string" Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
                <label>Telephone</label>
                <RadzenTextBox @bind-Value="@_model.Telephone" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create branch" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_branches.Count == 0)
    {
        <p class="muted">No branches yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_branches" TValue="BranchDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="BranchDto" Title="Company">
                    <Template>
                        @CompanyName(context.CompanyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BranchDto" Property="Code" Title="Code" />
                <RadzenDataGridColumn TItem="BranchDto" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="BranchDto" Property="Telephone" Title="Telephone" />
                <RadzenDataGridColumn TItem="BranchDto" Title="Status">
                    <Template>
                        @if (context.Enabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disabled" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<CompanyDto> _companies = [];
    private List<BranchDto> _branches = [];
    private CreateBranchDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _companies = [.. await OrganizationService.ListCompaniesAsync()];
        _branches = [.. await OrganizationService.ListBranchesAsync()];
    }

    private string CompanyName(Guid companyId)
        => _companies.FirstOrDefault(c => c.Id == companyId)?.Name ?? "(unknown company)";

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await OrganizationService.CreateBranchAsync(_model);
            _model = new CreateBranchDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}