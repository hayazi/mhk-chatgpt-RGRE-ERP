@page "/roles"
@using RGRE.ERP.Application.Platform
@using RGRE.ERP.Domain.Security
@rendermode InteractiveServer
@inject IRoleAdminService RoleService

<h1>Roles</h1>
<h2>Permission bundles (legacy: Permissions matrix)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New role</h2>
    <RadzenTemplateForm TItem="CreateRoleDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Role">
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
                <label>Description</label>
                <RadzenTextBox @bind-Value="@_model.Description" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Permissions">
                <RadzenCheckBoxList
                    Value="@_model.Permissions"
                    TValue="string"
                    Data="@AppPermissions.All"
                    Style="width:100%"
                    Change="@OnPermissionsChanged" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create role" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_roles.Count == 0)
    {
        <p class="muted">No roles yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_roles" TValue="RoleDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="RoleDto" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="RoleDto" Property="Description" Title="Description" />
                <RadzenDataGridColumn TItem="RoleDto" Title="Permissions">
                    <Template>
                        @string.Join(", ", context.Permissions)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<RoleDto> _roles = [];
    private CreateRoleDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _roles = [.. await RoleService.ListAsync()];

    private void OnPermissionsChanged(IEnumerable<string> selected)
    {
        _model.Permissions = selected is null ? [] : selected.ToList();
    }

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await RoleService.CreateAsync(_model);
            _model = new CreateRoleDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}