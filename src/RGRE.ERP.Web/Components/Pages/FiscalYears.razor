@page "/fiscal-years"
@using RGRE.ERP.Application.Platform
@using RGRE.ERP.Domain.Common
@rendermode InteractiveServer
@inject IOrganizationService OrganizationService
@inject IFiscalYearService FiscalYearService

<h1>Fiscal Years</h1>
<h2>Accounting periods (legacy: FYear) — posting is blocked into closed years</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New fiscal year</h2>
    <RadzenTemplateForm TItem="CreateFiscalYearDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Period">
                <label>Company *</label>
                <RadzenDropDown
                    @bind-Value="@_model.CompanyId"
                    TValue="Guid"
                    Data="@_companies"
                    TextProperty="Name"
                    ValueProperty="Id"
                    Placeholder="—"
                    Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
                <label>Start (Jalali, e.g. 1405/01/01) *</label>
                <RadzenTextBox @bind-Value="@_startJalali" TValue="string" Style="width:100%" />
                <label>End (Jalali, e.g. 1405/12/29) *</label>
                <RadzenTextBox @bind-Value="@_endJalali" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create fiscal year" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_fiscalYears.Count == 0)
    {
        <p class="muted">No fiscal years yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_fiscalYears" TValue="FiscalYearDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="FiscalYearDto" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="FiscalYearDto" Title="Company">
                    <Template>
                        @CompanyName(context.CompanyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FiscalYearDto" Property="StartDateJalali" Title="Start" />
                <RadzenDataGridColumn TItem="FiscalYearDto" Property="EndDateJalali" Title="End" />
                <RadzenDataGridColumn TItem="FiscalYearDto" Title="Status">
                    <Template>
                        @if (context.IsClosed)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Closed" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Open" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FiscalYearDto" Title="">
                    <Template>
                        @if (context.IsClosed)
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Reopen" Click="@(() => ReopenAsync(context))" />
                        }
                        else
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Close" Click="@(() => CloseAsync(context))" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<CompanyDto> _companies = [];
    private List<FiscalYearDto> _fiscalYears = [];
    private CreateFiscalYearDto _model = new();
    private string _startJalali = "";
    private string _endJalali = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _companies = [.. await OrganizationService.ListCompaniesAsync()];
        _fiscalYears = [.. await FiscalYearService.ListAsync()];
    }

    private string CompanyName(Guid companyId)
        => _companies.FirstOrDefault(c => c.Id == companyId)?.Name ?? "(unknown company)";

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            if (!JalaliDate.TryParse(_startJalali, out var start))
                throw new ArgumentException($"Invalid Jalali start date '{_startJalali}'.");

            if (!JalaliDate.TryParse(_endJalali, out var end))
                throw new ArgumentException($"Invalid Jalali end date '{_endJalali}'.");

            _model.StartDate = start;
            _model.EndDate = end;

            await FiscalYearService.CreateAsync(_model);

            _model = new CreateFiscalYearDto();
            _startJalali = _endJalali = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CloseAsync(FiscalYearDto fy)
    {
        _error = null;
        try
        {
            await FiscalYearService.CloseAsync(fy.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReopenAsync(FiscalYearDto fy)
    {
        _error = null;
        try
        {
            await FiscalYearService.ReopenAsync(fy.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}