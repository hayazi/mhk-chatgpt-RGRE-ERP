@page "/partners"
@inject UiLookups Lookups
@inject IPartnerAppService PartnerService

<h1>Partners</h1>
<h2>Customers & suppliers (legacy: Account / Customer / Corporations)</h2>

<div class="card">
    <h2>Add partner</h2>
    <form @onsubmit="CreateAsync">
        <div class="row">
            <div class="field">
                <label>Code *</label>
                <input @bind="_code" />
            </div>
            <div class="field">
                <label>Name *</label>
                <input @bind="_name" />
            </div>
            <div class="field">
                <label>Kind</label>
                <select @bind="_kind">
                    <option>Customer</option>
                    <option>Supplier</option>
                    <option>Customer,Supplier</option>
                </select>
            </div>
            <div class="field">
                <label>Telephone</label>
                <input @bind="_telephone" />
            </div>
        </div>
        <button type="submit">Add</button>
        <span class="error">@_error</span>
    </form>
</div>

<div class="card">
    <table class="grid">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Kind</th>
                <th>Telephone</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _partners)
            {
                var id = p.Id;
                var blocked = p.IsBlocked;
                <tr>
                    <td>@p.Code</td>
                    <td>@p.Name</td>
                    <td>@p.Kind</td>
                    <td>@p.Telephone</td>
                    <td>
                        @if (p.IsBlocked)
                        {
                            <span class="badge cancelled">Blocked</span>
                        }
                        else
                        {
                            <span class="badge posted">Active</span>
                        }
                    </td>
                    <td>
                        <button class="secondary" @onclick="() => ToggleAsync(id, blocked)">
                            @(blocked ? "Unblock" : "Block")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<PartnerDto> _partners = [];
    private string _code = "";
    private string _name = "";
    private string _kind = "Customer";
    private string? _telephone;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _partners = [.. await PartnerService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await PartnerService.CreateAsync(new CreatePartnerDto
            {
                Code = _code,
                Name = _name,
                Kind = _kind,
                Telephone = _telephone,
            });
            _code = _name = "";
            _telephone = null;
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception currentEx)
        {
            _error = currentEx.Message;
        }
    }

    private async Task ToggleAsync(Guid id, bool blocked)
    {
        if (blocked)
        {
            await PartnerService.UnblockAsync(id);
        }
        else
        {
            await PartnerService.BlockAsync(id);
        }

        await LoadAsync();
    }
}
