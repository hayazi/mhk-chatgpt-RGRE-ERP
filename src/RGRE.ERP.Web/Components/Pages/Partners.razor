@page "/partners"
@inject UiLookups Lookups
@inject IPartnerAppService PartnerService

<h1>Partners</h1>
<h2>Customers & suppliers (legacy: Account / Customer / Corporations)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">Add partner</h2>
    <RadzenTemplateForm TItem="CreatePartnerDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Identification">
                <label>Code *</label>
                <RadzenTextBox @bind-Value="@_model.Code" TValue="string" Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
            </RadzenFieldset>
            <RadzenFieldset Legend="Kind &amp; contact">
                <label>Kind</label>
                <RadzenDropDown
                    @bind-Value="@_model.Kind"
                    TValue="string"
                    Data="@(new[] { "Customer", "Supplier", "Customer,Supplier" })"
                    Style="width:100%" />
                <label>Telephone</label>
                <RadzenTextBox @bind-Value="@_model.Telephone" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    <RadzenDataGrid Data="@_partners" TValue="PartnerDto" Style="width:100%">
        <Columns>
            <RadzenDataGridColumn TItem="PartnerDto" Property="Code" Title="Code" />
            <RadzenDataGridColumn TItem="PartnerDto" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="PartnerDto" Property="Kind" Title="Kind" />
            <RadzenDataGridColumn TItem="PartnerDto" Property="Telephone" Title="Telephone" />
            <RadzenDataGridColumn TItem="PartnerDto" Title="Status">
                <Template>
                    @if (context.IsBlocked)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Blocked" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PartnerDto" Title="">
                <Template>
                    <RadzenButton ButtonStyle="ButtonStyle.Light"
                                  Text="@(context.IsBlocked ? "Unblock" : "Block")"
                                  Click="@(() => ToggleAsync(context.Id, context.IsBlocked))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<PartnerDto> _partners = [];
    private CreatePartnerDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _partners = [.. await PartnerService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await PartnerService.CreateAsync(_model);
            _model = new CreatePartnerDto();
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleAsync(Guid id, bool blocked)
    {
        if (blocked)
        {
            await PartnerService.UnblockAsync(id);
        }
        else
        {
            await PartnerService.BlockAsync(id);
        }

        await LoadAsync();
    }
}