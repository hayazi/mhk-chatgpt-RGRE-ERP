@page "/units"
@inject UiLookups Lookups
@inject IUnitAppService UnitService

<h1>Units</h1>
<h2>Legacy: Unit / UnitRatio</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">Add unit</h2>
    <RadzenTemplateForm TItem="CreateUnitDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Unit">
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
                <label>Conversion factor</label>
                <RadzenNumeric @bind-Value="@_model.ConversionFactor" TValue="decimal" Format="0.####" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    <RadzenDataGrid Data="@_units" TValue="Unit" Style="width:100%">
        <Columns>
            <RadzenDataGridColumn TItem="Unit" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="Unit" Property="ConversionFactor" Title="Conversion factor" FormatString="{0:0.####}" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<Unit> _units = [];
    private CreateUnitDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _units = [.. await UnitService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await UnitService.CreateAsync(_model);
            _model = new CreateUnitDto();
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}