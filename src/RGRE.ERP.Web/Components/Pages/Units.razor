@page "/units"
@inject UiLookups Lookups
@inject IUnitAppService UnitService

<h1>Units</h1>
<h2>Legacy: Unit / UnitRatio</h2>

<div class="card">
    <h2>Add unit</h2>
    <form @onsubmit="CreateAsync">
        <div class="row">
            <div class="field">
                <label>Name *</label>
                <input @bind="_name" />
            </div>
            <div class="field">
                <label>Conversion factor</label>
                <input type="number" step="0.0001" @bind="_factor" />
            </div>
        </div>
        <button type="submit">Add</button>
        <span class="error">@_error</span>
    </form>
</div>

<div class="card">
    <table class="grid">
        <thead>
            <tr>
                <th>Name</th>
                <th class="num">Conversion factor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in _units)
            {
                <tr>
                    <td>@u.Name</td>
                    <td class="num">@u.ConversionFactor</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Unit> _units = [];
    private string _name = "";
    private decimal _factor = 1m;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _units = [.. await UnitService.ListAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await UnitService.CreateAsync(new CreateUnitDto { Name = _name, ConversionFactor = _factor });
            _name = "";
            _factor = 1m;
            await Lookups.RefreshAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
