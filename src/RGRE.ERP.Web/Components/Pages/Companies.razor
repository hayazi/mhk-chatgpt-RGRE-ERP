@page "/companies"
@using RGRE.ERP.Application.Platform
@rendermode InteractiveServer
@inject IOrganizationService OrganizationService

<h1>Companies</h1>
<h2>Legal companies (legacy: Corporations)</h2>

<RadzenCard>
    <h2 style="margin:0 0 0.6rem">New company</h2>
    <RadzenTemplateForm TItem="CreateCompanyDto" Data="@_model" Submit="@CreateAsync">
        <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
            <RadzenFieldset Legend="Identification">
                <label>Code *</label>
                <RadzenTextBox @bind-Value="@_model.Code" TValue="string" Style="width:100%" />
                <label>Name *</label>
                <RadzenTextBox @bind-Value="@_model.Name" TValue="string" Style="width:100%" />
                <label>Economic code</label>
                <RadzenTextBox @bind-Value="@_model.EconomicCode" TValue="string" Style="width:100%" />
                <label>National id</label>
                <RadzenTextBox @bind-Value="@_model.NationalId" TValue="string" Style="width:100%" />
            </RadzenFieldset>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit" Text="Create company" Style="margin-top:0.8rem" />
        <span class="error" style="margin-left:0.8rem">@_error</span>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    @if (_companies.Count == 0)
    {
        <p class="muted">No companies yet.</p>
    }
    else
    {
        <RadzenDataGrid Data="@_companies" TValue="CompanyDto" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="CompanyDto" Property="Code" Title="Code" />
                <RadzenDataGridColumn TItem="CompanyDto" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="CompanyDto" Property="EconomicCode" Title="Economic code" />
                <RadzenDataGridColumn TItem="CompanyDto" Property="NationalId" Title="National id" />
                <RadzenDataGridColumn TItem="CompanyDto" Title="Status">
                    <Template>
                        @if (context.Enabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disabled" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CompanyDto" Title="">
                    <Template>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Text="@(context.Enabled ? "Disable" : "Enable")"
                                      Click="@(() => ToggleAsync(context.Id, context.Enabled))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<CompanyDto> _companies = [];
    private CreateCompanyDto _model = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _companies = [.. await OrganizationService.ListCompaniesAsync()];

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            await OrganizationService.CreateCompanyAsync(_model);
            _model = new CreateCompanyDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleAsync(Guid id, bool enabled)
    {
        _error = null;
        try
        {
            await OrganizationService.SetCompanyEnabledAsync(id, !enabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}