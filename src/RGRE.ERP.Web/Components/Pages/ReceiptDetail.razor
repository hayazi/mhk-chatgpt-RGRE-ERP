@page "/receipts/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IReceiptAppService ReceiptService
@inject NavigationManager Navigation

@if (_receipt is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <h1>Receipt @_receipt.DocumentNumber</h1>
    <h2>
        @Lookups.WarehouseName(_receipt.WarehouseId) · @JalaliUi.Format(_receipt.DocumentDate) ·
        <RadzenBadge BadgeStyle="@(IsDraft ? BadgeStyle.Warning : (_receipt.Status == "Posted" ? BadgeStyle.Success : BadgeStyle.Danger))"
                     Text="@_receipt.Status" />
    </h2>

    <p class="muted">@_receipt.Description</p>

    @if (IsDraft)
    {
        <RadzenCard>
            <h2 style="margin:0 0 0.6rem">Add line</h2>
            <RadzenTemplateForm TItem="AddReceiptLineDto" Data="@_lineModel" Submit="@AddLineAsync">
                <RadzenStack Gap="0.8rem" Wrap="FlexWrap.Wrap">
                    <RadzenFieldset Legend="Line">
                        <label>Goods *</label>
                        <RadzenDropDown
                            @bind-Value="@_lineModel.GoodsId"
                            TValue="Guid"
                            Data="@Lookups.Goods.Where(g => g.Enabled)"
                            TextProperty="Code"
                            ValueProperty="Id"
                            Placeholder="—"
                            Style="width:100%" />
                        <label>Unit</label>
                        <RadzenDropDown
                            @bind-Value="@_lineModel.UnitId"
                            TValue="Guid"
                            Data="@Lookups.Units"
                            TextProperty="Name"
                            ValueProperty="Id"
                            Placeholder="—"
                            Style="width:100%" />
                        <label>Quantity *</label>
                        <RadzenNumeric @bind-Value="@_lineModel.Quantity" TValue="decimal" Style="width:100%" />
                        <label>Unit price *</label>
                        <RadzenNumeric @bind-Value="@_lineModel.UnitPrice" TValue="decimal" Format="N2" Style="width:100%" />
                    </RadzenFieldset>
                </RadzenStack>
                <RadzenButton ButtonType="ButtonType.Submit" Text="Add line" Style="margin-top:0.8rem" />
                <span class="error" style="margin-left:0.8rem">@_error</span>
            </RadzenTemplateForm>
        </RadzenCard>
    }

    <RadzenCard>
        <h2 style="margin:0 0 0.6rem">Lines</h2>
        @if (_receipt.Lines.Count == 0)
        {
            <p class="muted">No lines yet.</p>
        }
        else
        {
            <RadzenDataGrid Data="@_receipt.Lines" TValue="ReceiptLineDto" Style="width:100%">
                <Columns>
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Title="Goods">
                        <Template>
                            @Lookups.GoodsName(context.GoodsId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Title="Unit">
                        <Template>
                            @Lookups.UnitName(context.UnitId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Property="Quantity" Title="Qty" />
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Property="UnitPrice" Title="Unit price" FormatString="{0:N2}" />
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Property="Amount" Title="Amount" FormatString="{0:N2}" />
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Property="Description" Title="Description" />
                    <RadzenDataGridColumn TItem="ReceiptLineDto" Title="">
                        <Template>
                            @if (IsDraft)
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="✕" Click="@(() => RemoveLineAsync(context.Id))" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <FooterTemplate>
                    <strong>Total: @_receipt.Lines.Sum(l => l.Amount).ToString("N2")</strong>
                </FooterTemplate>
            </RadzenDataGrid>
        }
    </RadzenCard>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.6rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Style="margin-top:1rem">
        @if (IsDraft)
        {
            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Post to stock" Click="@PostAsync" Disabled="@(_receipt.Lines.Count == 0)" />
        }
        @if (_receipt.Status == "Posted")
        {
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Cancel receipt" Click="@CancelAsync" />
        }
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Back to list" Click="@(() => Navigation.NavigateTo("receipts"))" />
        <span class="error">@_error</span>
    </RadzenStack>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ReceiptDto? _receipt;
    private AddReceiptLineDto _lineModel = new();
    private string? _error;

    private bool IsDraft => _receipt?.Status == "Draft";

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _receipt = await ReceiptService.GetAsync(Id);

    private async Task AddLineAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.AddLineAsync(Id, _lineModel);
            _lineModel = new AddReceiptLineDto();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveLineAsync(Guid lineId)
    {
        _error = null;
        try
        {
            await ReceiptService.RemoveLineAsync(Id, lineId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PostAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.PostAsync(Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.CancelAsync(Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}