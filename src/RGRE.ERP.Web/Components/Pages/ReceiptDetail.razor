@page "/receipts/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UiLookups Lookups
@inject IReceiptAppService ReceiptService
@inject NavigationManager Navigation

@if (_receipt is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <h1>Receipt @_receipt.DocumentNumber</h1>
    <h2>
        @Lookups.WarehouseName(_receipt.WarehouseId) · @JalaliUi.Format(_receipt.DocumentDate) ·
        <span class="badge @_receipt.Status.ToLower()">@_receipt.Status</span>
    </h2>

    <p class="muted">@_receipt.Description</p>

    @if (IsDraft)
    {
        <div class="card">
            <h2>Add line</h2>
            <form @onsubmit="AddLineAsync">
                <div class="row">
                    <div class="field">
                        <label>Goods *</label>
                        <select @bind="_goodsId">
                            <option value="">—</option>
                            @foreach (var g in Lookups.Goods.Where(g => g.Enabled))
                            {
                                <option value="@g.Id">@g.Code — @g.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Unit</label>
                        <select @bind="_unitId">
                            <option value="">—</option>
                            @foreach (var u in Lookups.Units)
                            {
                                <option value="@u.Id">@u.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Quantity *</label>
                        <input type="number" step="0.0001" @bind="_qty" />
                    </div>
                    <div class="field">
                        <label>Unit price *</label>
                        <input type="number" step="0.01" @bind="_price" />
                    </div>
                </div>
                <button type="submit">Add line</button>
                <span class="error">@_error</span>
            </form>
        </div>
    }

    <div class="card">
        <h2>Lines</h2>
        @if (_receipt.Lines.Count == 0)
        {
            <p class="muted">No lines yet.</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th>Goods</th>
                        <th>Unit</th>
                        <th class="num">Qty</th>
                        <th class="num">Unit price</th>
                        <th class="num">Amount</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _receipt.Lines)
                    {
                        var lineId = line.Id;
                        <tr>
                            <td>@Lookups.GoodsName(line.GoodsId)</td>
                            <td>@Lookups.UnitName(line.UnitId)</td>
                            <td class="num">@line.Quantity</td>
                            <td class="num">@line.UnitPrice.ToString("N2")</td>
                            <td class="num">@line.Amount.ToString("N2")</td>
                            <td>@line.Description</td>
                            <td>
                                @if (IsDraft)
                                {
                                    <button class="danger" @onclick="() => RemoveLineAsync(lineId)">✕</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="num"><strong>Total</strong></td>
                        <td class="num"><strong>@_receipt.Lines.Sum(l => l.Amount).ToString("N2")</strong></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    <div>
        @if (IsDraft)
        {
            <button @onclick="PostAsync" disabled="@(_receipt.Lines.Count == 0)">Post to stock</button>
        }
        @if (_receipt.Status == "Posted")
        {
            <button class="danger" @onclick="CancelAsync">Cancel receipt</button>
        }
        <a class="btn secondary" href="receipts">Back to list</a>
        <span class="error">@_error</span>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ReceiptDto? _receipt;
    private string _goodsId = "";
    private string _unitId = "";
    private decimal _qty;
    private decimal _price;
    private string? _error;

    private bool IsDraft => _receipt?.Status == "Draft";

    protected override async Task OnInitializedAsync()
    {
        await Lookups.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _receipt = await ReceiptService.GetAsync(Id);

    private async Task AddLineAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.AddLineAsync(Id, new AddReceiptLineDto
            {
                GoodsId = Guid.Parse(_goodsId),
                UnitId = Guid.Parse(_unitId),
                Quantity = _qty,
                UnitPrice = _price,
            });
            _qty = 0;
            _price = 0;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveLineAsync(Guid lineId)
    {
        _error = null;
        try
        {
            await ReceiptService.RemoveLineAsync(Id, lineId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PostAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.PostAsync(Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelAsync()
    {
        _error = null;
        try
        {
            await ReceiptService.CancelAsync(Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
